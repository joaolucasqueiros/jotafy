# Copie para .env.local. Nunca versione valores reais.
DATABASE_URL=postgresql://metatrack:metatrack_local@127.0.0.1:5432/metatrack
APP_URL=http://localhost:3000
# 32 bytes em base64: openssl rand -base64 32
ENCRYPTION_KEY=
# Aplicativo Meta do tipo Business. Callback: APP_URL/api/auth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# HMAC opcional para um relay próprio; deixe vazio na conexão direta Cakto.
# O segredo nativo da Cakto é configurado por workspace em Integrações.
CAKTO_RELAY_HMAC_SECRET=
# openssl rand -hex 32; autentica /api/jobs (Bearer) no Node e processor:http. Worker CLI não precisa desse valor.
CRON_SECRET=
# Domínio de e-mail permitido para cadastro; vazio permite cadastro público.
SIGNUP_EMAIL_DOMAIN=
# Entrega Mundo Criativo: mesmo segredo hexadecimal de 64 caracteres no Worker da loja.
DELIVERY_SERVICE_SECRET=
# Opcionais: os padrões são o workspace/produto Mundo Criativo já existente.
DELIVERY_WORKSPACE_PUBLIC_KEY=
DELIVERY_PRODUCT_NAME=
MUNDO_CRIATIVO_ORIGIN=https://mundocriativo.joaolucasqueirozag.workers.dev
